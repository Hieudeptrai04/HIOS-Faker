<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        ellekit filter plist for VcamFullMay.

        IMPORTANT: ellekit's `Filter > Bundles` matches FRAMEWORK bundle IDs
        loaded into a process (e.g. com.apple.UIKit), NOT the app's own
        CFBundleIdentifier. Live test on Dopamine 2 / ellekit 1.1.3 confirmed
        a Bundles list of app IDs (com.vng.zalo, etc.) matched nothing.

        To target specific apps, use `Filter > Executables` instead — this
        matches the executable name (last path component of the binary).
        For Zalo.app/Zalo → "Zalo". For musical_ly.app/musical_ly → "musical_ly".

        NEVER add system shell executables (sh, bash, sudo, ssh, cp, ls) or
        com.apple.* frameworks here — our libc hooks (fopen/stat/access) break
        PAM auth and shell tooling, locking SSH out of the device.
    -->
    <key>Filter</key>
    <dict>
        <key>Executables</key>
        <array>
            <!-- Messaging / video call -->
            <string>Zalo</string>
            <string>Facebook</string>
            <string>Messenger</string>
            <string>WhatsApp</string>
            <string>WeChat</string>
            <string>MicroMessenger</string>
            <string>Viber</string>
            <string>Skype for iPhone</string>
            <string>Telegram</string>
            <string>Discord</string>
            <string>LINE</string>
            <string>KakaoTalk</string>

            <!-- Social / video upload -->
            <string>Instagram</string>
            <string>TikTok</string>
            <string>musical_ly</string>
            <string>Aweme</string>
            <string>Snapchat</string>
            <string>YouTube</string>
            <string>Twitter</string>

            <!-- Productivity that uses camera (QR scan, docs) -->
            <string>Outlook</string>
            <string>Chrome</string>

            <!-- Banking / e-KYC (selfie verification) -->
            <string>TPBank</string>
            <string>ACBMobileApp</string>
            <string>VPBankNEO</string>
        </array>
    </dict>
</dict>
</plist>
