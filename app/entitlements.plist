<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.security.container-required</key>
    <false/>
    <!-- Pre-grant TCC entries so iOS skips the permission dialog AND
         Photos / Camera frameworks get access despite the app having
         no sandbox container (TCC normally tracks per-container, so a
         containerless app can't be granted via the standard prompt).
         Standard pattern for jailbreak tools that need media access. -->
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServicePhotos</string>
        <string>kTCCServicePhotosAdd</string>
        <string>kTCCServiceCamera</string>
        <string>kTCCServiceMicrophone</string>
        <string>kTCCServiceMediaLibrary</string>
        <string>kTCCServiceAddressBook</string>
    </array>
    <!-- TCC MANAGER rights: let this app ask the running tccd to RESET another
         bundle's TCC entries (Contacts/Camera/Photos/Mic) so they re-prompt like
         a fresh install — tccd drops its RAM cache in place, no daemon restart. -->
    <key>com.apple.private.tcc.manager</key>
    <true/>
    <key>com.apple.private.tcc.manager.access.delete</key>
    <true/>
    <key>com.apple.private.tcc.manager.access.modify</key>
    <true/>
    <key>com.apple.private.tcc.manager.access.read</key>
    <true/>
    <!-- locationd manager right: lets the app reset another bundle's LOCATION
         authorization (to notDetermined) so it re-prompts like a fresh install.
         SAFE now that the MG tweak only claims AuthorizedAlways when location is
         REALLY granted (returns the real status while notDetermined) — so a
         reset no longer creates the system-vs-app contradiction that locked the
         fix9/10 accounts. -->
    <key>com.apple.locationd.authorizeapplications</key>
    <true/>
    <!-- Wildcard keychain access (keychain_dumper technique). On an AMFI-patched
         jailbreak this lets HIOS Faker read/write ANY app's keychain-access-group
         directly, WITHOUT that app running. Needed to capture Viber's login
         credential (7 items in 69V327AA4Z.group.viber.share.keychain, the key that
         decrypts SecureStorage.data) at backup time — the in-app dump was too
         fragile (depended on Viber launching + the tweak firing). This is what
         makes a Viber .rrs portable to another device. -->
    <key>com.apple.keystore.access-keychain-keys</key>
    <true/>
    <!-- Keychain access groups. The '*' wildcard (keychain_dumper technique) is
         SILENTLY STRIPPED by ldid on this platform — verified via `ldid -e` on the
         installed binary: only the explicit foreign group survived, '*' was gone.
         So a host-side keychain wipe of a target app needs that app's groups listed
         EXPLICITLY here (foreign-team groups ARE honored on an AMFI-patched JB — the
         Viber group already works). Add each target app's groups; without them
         SecItemDelete is a no-op that returns a spurious errSecSuccess. -->
    <key>keychain-access-groups</key>
    <array>
        <string>69V327AA4Z.group.viber.share.keychain</string>
        <!-- Zalo (vn.com.vng.zingalo): shared + default + extension groups -->
        <string>CVB6BX97VM.group.keychain.vn.com.vng.zalo</string>
        <string>CVB6BX97VM.vn.com.vng.zingalo</string>
        <string>CVB6BX97VM.vn.com.vng.zingalo.notificationserviceextension</string>
        <string>CVB6BX97VM.vn.com.vng.zingalo.shareext</string>
        <!-- kept last; stripped by ldid but harmless, and honored if a future JB does -->
        <string>*</string>
    </array>
</dict>
</plist>
