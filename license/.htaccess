# Chặn tải trực tiếp database key (keys.json) qua trình duyệt.
# PHP vẫn đọc/ghi được bình thường; chỉ chặn truy cập HTTP từ ngoài.
<FilesMatch "\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
