<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.apple.Maps</string>
			<string>com.apple.weather</string>
			<string>com.apple.Weather</string>
			<string>com.apple.camera</string>
			<string>com.apple.Camera</string>
			<string>com.apple.mobileslideshow</string>
			<string>com.apple.Spotlight</string>
			<string>com.apple.findmy</string>
			<string>com.apple.FindMy</string>
			<string>com.apple.compass</string>
			<string>com.apple.Compass</string>
			<!-- v2.5.33: WebKit XPCs so geolocation calls from inside a
			     WKWebView (including third-party app browsers) read fake
			     coords. Safari's main process already gets the Safari
			     sidecar but its WebContent XPC sometimes pulls location
			     via the UI process channel that doesn't go through us. -->
			<string>com.apple.WebKit.WebContent</string>
			<string>com.apple.WebKit.Networking</string>
		</array>
		<key>Mode</key>
		<string>Any</string>
	</dict>
</dict>
</plist>
