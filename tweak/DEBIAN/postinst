#!/bin/bash
# ChangeInfoIos - Post Install Script (v2.2.1)
# Auto-fix Sileo/apt/dpkg issues + install tweak

export PATH="/usr/bin:/usr/sbin:/usr/libexec:/bin:/sbin:/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/usr/libexec:$PATH"

echo "[ChangeInfoIos] v2.2.1 postinst starting..."

# ============================================================
# STEP 1: Fix broken dpkg state (from previous broken install)
# ============================================================
echo "[Step 1/4] Fixing dpkg state..."
dpkg --configure -a 2>/dev/null || true

# ============================================================
# STEP 2: Remove any OLD broken version of this tweak
# ============================================================
echo "[Step 2/4] Cleaning up old/broken versions..."
dpkg -r com.changeinfoios.tweak 2>/dev/null || true
# Also clean any leftover files from broken installs
rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/ChangeInfoIos.dylib 2>/dev/null || true
rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/ChangeInfoIos.plist 2>/dev/null || true
rm -f /var/jb/Applications/ChangeInfoIos.app 2>/dev/null || true
rm -f /Applications/ChangeInfoIos.app 2>/dev/null || true
# Clean any apt config that might be broken
rm -rf /var/jb/etc/apt/apt.conf.d/zz-changeinfoios 2>/dev/null || true
rm -rf /var/jb/etc/apt/sources.list.d/changeinfoios 2>/dev/null || true

# Re-configure dpkg after cleanup
dpkg --configure -a 2>/dev/null || true

echo "[Step 3/4] Installing ChangeInfoIos..."

# ============================================================
# STEP 3: Set proper permissions and ownership
# ============================================================
echo "[Step 4/4] Setting up SpringBoard..."

# Refresh icon cache
if command -v uicache >/dev/null 2>&1; then
    uicache -a 2>/dev/null || true
elif [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache -a 2>/dev/null || true
fi

# Respring to load tweak
sbreload 2>/dev/null || killall -9 SpringBoard 2>/dev/null || true

echo "[ChangeInfoIos] v2.2.1 installed successfully!"
echo "[ChangeInfoIos] Sileo should work normally now."
