<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!--
			Bundles=com.apple.UIKit ⇒ ellekit/substrate injects the dylib into
			every process that links UIKit (≈ every GUI app). Without this we
			were limited to a hard-coded list of 15 apps; if the user wanted
			to spoof anything else (banking apps, e-commerce, new social apps)
			the dylib was never loaded and "Change" couldn't take effect.
			Tweak.xm's %ctor early-exits for SpringBoard/Settings/CoreServices
			via the runtime exclusion list, and isCurrentBundleTargeted()
			gates per-process so non-target apps install zero hooks.
		-->
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
		</array>
		<key>Mode</key>
		<string>Any</string>
	</dict>
</dict>
</plist>
