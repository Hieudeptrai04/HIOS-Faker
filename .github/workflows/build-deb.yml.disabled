name: Build DEB (Ubuntu)

on:
  workflow_dispatch:
  push:
    branches:
      - master
    paths:
      - "tweak/**"
      - "app/**"

permissions:
  contents: read
  actions: write

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4

      - name: Install deps
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends \
            perl fakeroot build-essential cmake curl xz-utils \
            libplist-dev libssl-dev zlib1g-dev git dpkg-dev

      - name: Install ldid
        run: |
          cd /tmp
          git clone --depth 1 https://github.com/ProcursusTeam/ldid.git
          cd ldid && make -j"$(nproc)"
          sudo install -m 0755 ldid /usr/local/bin/ldid

      - name: Clone Theos
        run: |
          git clone --recursive https://github.com/theos/theos.git $HOME/theos

      - name: Install toolchain
        run: |
          mkdir -p $HOME/theos/toolchain
          curl -fSL https://github.com/kabiroberai/swift-toolchain-linux/releases/download/v2.3.0/swift-5.8-ubuntu22.04.tar.xz -o /tmp/toolchain.tar.xz
          tar -xJf /tmp/toolchain.tar.xz -C $HOME/theos/toolchain/

      - name: Download SDK
        run: |
          mkdir -p $HOME/theos/sdks
          curl -fSL https://github.com/theos/sdks/releases/download/master-146e41f/iPhoneOS16.5.sdk.tar.xz -o /tmp/sdk.tar.xz
          tar -xJf /tmp/sdk.tar.xz -C $HOME/theos/sdks/

      - name: Build tweak
        env:
          THEOS: $HOME/theos
          THEOS_PACKAGE_SCHEME: rootless
        run: |
          cd tweak
          rm -rf packages/ .theos/ obj/
          make package THEOS=$THEOS THEOS_PACKAGE_SCHEME=rootless FINALPACKAGE=1 ARCHS=arm64

      - name: Build app
        env:
          THEOS: $HOME/theos
          THEOS_PACKAGE_SCHEME: rootless
        run: |
          cd app
          rm -rf packages/ .theos/ obj/
          make package THEOS=$THEOS THEOS_PACKAGE_SCHEME=rootless FINALPACKAGE=1 ARCHS=arm64

      - name: Show outputs
        run: |
          find . -name "*.deb" -type f -exec ls -lh {} \;

      - name: Combine packages
        run: |
          mkdir -p combined/DEBIAN
          mkdir -p combined/var/jb/Library/MobileSubstrate/DynamicLibraries
          mkdir -p combined/var/jb/Applications

          TWEAK=$(find . -path "*/tweak/packages/*.deb" -type f | head -1)
          if [ -n "$TWEAK" ]; then
            dpkg-deb -x "$TWEAK" /tmp/tweak-extract
            cp -r /tmp/tweak-extract/var/jb/Library/MobileSubstrate/DynamicLibraries/* combined/var/jb/Library/MobileSubstrate/DynamicLibraries/ 2>/dev/null || true
          fi

          APP=$(find . -name "*.deb" -type f ! -path "*/tweak/*" | head -1)
          if [ -n "$APP" ]; then
            dpkg-deb -x "$APP" /tmp/app-extract
            cp -r /tmp/app-extract/var/jb/Applications/* combined/var/jb/Applications/ 2>/dev/null || true
          fi

      - name: Create final deb
        run: |
          cat > combined/DEBIAN/control << 'EOF'
Package: com.changeinfoios.tweak
Name: ChangeInfoIos
Version: 2.2.1-native
Architecture: iphoneos-arm64
Description: Device spoofer for iOS 15-16.7
Maintainer: ChangeInfoIos
Section: Tweaks
Depends: mobilesubstrate (>= 0.9.5000), firmware (>= 15.0)
EOF

          chmod 755 combined/DEBIAN/control
          mkdir -p packages
          dpkg-deb -b combined packages/ChangeInfoIos.deb
          ls -lh packages/

      - name: Upload deb
        uses: actions/upload-artifact@v4
        with:
          name: ChangeInfoIos-v2.2.1-ubuntu
          path: packages/ChangeInfoIos.deb
