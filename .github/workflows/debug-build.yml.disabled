# Standalone debug build workflow - manual dispatch only
name: Debug Build

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  debug-build:
    runs-on: macos-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Theos
        run: |
          export THEOS="$HOME/theos"
          echo "THEOS=$THEOS"
          if [ ! -d "$THEOS" ]; then
            echo "Cloning Theos..."
            git clone https://github.com/theos/theos.git "$THEOS"
          fi
          cd "$THEOS"
          git submodule update --init --recursive 2>&1 | tail -10
          echo "THEOS=$THEOS" >> $GITHUB_ENV

      - name: Setup ldid
        run: |
          brew install ldid 2>&1 | tail -5
          ldid -v || echo "ldid check failed"

      - name: Download SDK
        run: |
          export THEOS="$HOME/theos"
          mkdir -p "$THEOS/sdks"
          if [ ! -d "$THEOS/sdks/iPhoneOS16.5.sdk" ]; then
            echo "Downloading iOS SDK..."
            curl -fSL \
              "https://github.com/theos/sdks/releases/download/master-146e41f/iPhoneOS16.5.sdk.tar.xz" \
              -o /tmp/sdk.tar.xz
            tar -xf /tmp/sdk.tar.xz -C "$THEOS/sdks/"
          fi
          ls -la "$THEOS/sdks/"

      - name: Debug build
        env:
          THEOS: $HOME/theos
        run: |
          export THEOS="$HOME/theos"
          cd "${GITHUB_WORKSPACE}/tweak"
          echo "=== Workspace contents ==="
          ls -la
          echo ""
          echo "=== Makefile ==="
          cat Makefile
          echo ""
          echo "=== Tweak files ==="
          ls -la *.xm *.mm *.plist 2>/dev/null || echo "No tweak files found"
          echo ""
          echo "=== Building ==="
          make package THEOS="$THEOS" THEOS_PACKAGE_SCHEME=rootless FINALPACKAGE=1 2>&1 | tee /tmp/build_full.log
          BUILD_STATUS=${PIPESTATUS[0]}
          echo ""
          echo "=== Build exit status: $BUILD_STATUS ==="
          echo "=== Log size: $(wc -c < /tmp/build_full.log) bytes, $(wc -l < /tmp/build_full.log) lines ==="
          echo "=== Last 30 lines ==="
          tail -30 /tmp/build_full.log
          echo "=== Searching for errors ==="
          grep -i "error" /tmp/build_full.log || echo "No error keyword found"
          echo "=== Searching for warnings ==="
          grep -i "warning" /tmp/build_full.log | head -20 || echo "No warnings found"
          echo "=== Searching for clang ==="
          grep "clang" /tmp/build_full.log | head -10 || echo "No clang output"
          echo "=== Searching for make ==="
          grep "make" /tmp/build_full.log | head -10 || echo "No make output"

          echo "=== Checking for .deb ==="
          find . -name "*.deb" -type f -exec ls -lh {} \;

          echo "=== Exiting with code $BUILD_STATUS ==="
          exit $BUILD_STATUS
